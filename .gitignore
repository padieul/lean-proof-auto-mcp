# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
.env/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Lean / Lake
.lake/
lake-packages/
*.olean

# Logs / artifacts
artifacts/
logs/

# Temporary files
tmp/

# Test worktrees (should use temp mode instead)
.worktrees/

# Kiro - exclude user-specific settings but keep shared hooks/steering
.kiro/settings/
.kiro/cache/
.kiro/logs/

/CODE_REVIEWS

# Claude Code - exclude user-specific settings
.claude/settings.local.json

.artifacts

# Eval test reports (persistent results, not committed)
tests/lean-proof-auto-mcp-eval_tests/reports/*
!tests/lean-proof-auto-mcp-eval_tests/reports/.gitkeep

# Eval test logs (append-only run logs, not committed)
tests/lean-proof-auto-mcp-eval_tests/logs/*
!tests/lean-proof-auto-mcp-eval_tests/logs/.gitkeep
