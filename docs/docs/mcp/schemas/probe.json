{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lean-proof-auto-mcp.org/schemas/probe.json",
  "title": "Probe Tool Schema",
  "description": "Schema for the probe MCP tool that measures automation behavior on a single theorem",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": ["file", "theorem_id", "mode"],
      "properties": {
        "api_version": {
          "type": "string",
          "description": "API version for schema compatibility tracking",
          "default": "1.1.0",
          "examples": ["1.1.0"]
        },
        "file": {
          "type": "string",
          "description": "Path to the .lean file containing the theorem, relative to the project root",
          "minLength": 1,
          "examples": [
            "Mathlib/Data/List/Basic.lean",
            "MyProject/Theorems.lean"
          ]
        },
        "theorem_id": {
          "type": "string",
          "description": "Identifier of the theorem to probe",
          "minLength": 1,
          "examples": [
            "List.append_assoc",
            "MyProject.my_theorem"
          ]
        },
        "mode": {
          "type": "string",
          "description": "Automation mode to attempt",
          "enum": ["aesop", "aesop?", "grind"],
          "examples": ["aesop", "aesop?", "grind"]
        },
        "budget_s": {
          "type": "number",
          "description": "Maximum wall-clock time (in seconds) allowed for automation attempt. Hard timeout with process tree kill.",
          "default": 10.0,
          "minimum": 0.1,
          "maximum": 600.0,
          "examples": [10.0, 5.0, 30.0]
        },
        "trace_config": {
          "type": ["object", "null"],
          "description": "Optional trace configuration for debugging automation behavior",
          "default": null,
          "properties": {
            "aesop": {
              "type": "boolean",
              "description": "Enable aesop trace output",
              "default": false
            },
            "grind": {
              "type": "boolean",
              "description": "Enable grind trace output",
              "default": false
            }
          },
          "additionalProperties": false,
          "examples": [
            null,
            {"aesop": true},
            {"grind": true}
          ]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "file": "Mathlib/Data/List/Basic.lean",
          "theorem_id": "List.append_assoc",
          "mode": "aesop",
          "budget_s": 10.0
        },
        {
          "file": "MyProject/Theorems.lean",
          "theorem_id": "MyProject.my_theorem",
          "mode": "aesop?",
          "budget_s": 5.0,
          "trace_config": {"aesop": true}
        }
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "api_version",
        "status",
        "run_id",
        "probe_result",
        "diagnostics",
        "timing",
        "metadata"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "description": "API version for schema compatibility tracking",
          "const": "1.1.0",
          "examples": ["1.1.0"]
        },
        "status": {
          "type": "string",
          "description": "Overall probe execution status",
          "enum": ["success", "fail", "timeout", "error"],
          "examples": ["success", "fail", "timeout", "error"]
        },
        "run_id": {
          "type": "string",
          "description": "Unique identifier for artifact lookup and correlation. Format: probe-{timestamp}-{file_hash}-{random_suffix}",
          "pattern": "^probe-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}-[a-f0-9]{6}$",
          "examples": [
            "probe-20250126-143022-a1b2c3d4-abc123",
            "probe-20250126-143100-b2c3d4e5-def456"
          ]
        },
        "probe_result": {
          "type": "object",
          "description": "Structured outcome of automation attempt",
          "required": ["mode", "outcome", "classification"],
          "properties": {
            "mode": {
              "type": "string",
              "description": "Automation mode that was used",
              "enum": ["aesop", "aesop?", "grind"],
              "examples": ["aesop", "aesop?", "grind"]
            },
            "outcome": {
              "type": "string",
              "description": "Raw outcome of automation attempt",
              "enum": ["closed", "not_closed", "timeout", "error"],
              "examples": ["closed", "not_closed", "timeout", "error"]
            },
            "classification": {
              "type": "string",
              "description": "Deterministic classification of automation behavior",
              "enum": ["trivial", "promising", "failed", "timed_out", "error"],
              "examples": ["trivial", "promising", "failed", "timed_out", "error"]
            },
            "suggested_script": {
              "type": ["string", "null"],
              "description": "Suggested proof script (only for aesop? mode when successful)",
              "default": null,
              "examples": [
                null,
                "simp [List.append_assoc]",
                "aesop (add norm simp [List.cons_append])"
              ]
            }
          },
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "array",
          "description": "Structured diagnostics from Lean, sorted deterministically by (file, line, col, severity, message)",
          "items": {
            "type": "object",
            "required": ["severity", "message", "location"],
            "properties": {
              "severity": {
                "type": "string",
                "description": "Diagnostic severity level",
                "enum": ["error", "warning", "info"],
                "examples": ["error", "warning", "info"]
              },
              "message": {
                "type": "string",
                "description": "Human-readable diagnostic message",
                "minLength": 1,
                "examples": [
                  "unsolved goals\n⊢ List α → List α → List α",
                  "declaration uses 'sorry'"
                ]
              },
              "location": {
                "type": ["object", "null"],
                "description": "Source location of diagnostic",
                "required": ["file", "line", "col"],
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "File path",
                    "minLength": 1,
                    "examples": ["MyProject/Theorems.lean"]
                  },
                  "line": {
                    "type": "integer",
                    "description": "Line number (1-indexed)",
                    "minimum": 1,
                    "examples": [15, 42]
                  },
                  "col": {
                    "type": "integer",
                    "description": "Column number (1-indexed)",
                    "minimum": 1,
                    "examples": [8, 20]
                  },
                  "end_line": {
                    "type": ["integer", "null"],
                    "description": "End line number (optional)",
                    "minimum": 1,
                    "examples": [15, 45, null]
                  },
                  "end_col": {
                    "type": ["integer", "null"],
                    "description": "End column number (optional)",
                    "minimum": 1,
                    "examples": [11, 30, null]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "examples": [
            [],
            [
              {
                "severity": "error",
                "message": "unsolved goals\n⊢ List α → List α → List α",
                "location": {
                  "file": "MyProject/Theorems.lean",
                  "line": 15,
                  "col": 8,
                  "end_line": 15,
                  "end_col": 11
                }
              }
            ]
          ]
        },
        "timing": {
          "type": "object",
          "description": "Execution time breakdown",
          "required": ["elapsed_ms", "budget_s"],
          "properties": {
            "elapsed_ms": {
              "type": "number",
              "description": "Total elapsed time for probe execution in milliseconds",
              "minimum": 0,
              "examples": [245.5, 1820.3, 5080.0]
            },
            "budget_s": {
              "type": "number",
              "description": "Budget that was allocated in seconds",
              "minimum": 0,
              "examples": [10.0, 5.0, 30.0]
            }
          },
          "additionalProperties": false,
          "examples": [
            {
              "elapsed_ms": 245.5,
              "budget_s": 10.0
            },
            {
              "elapsed_ms": 5080.0,
              "budget_s": 5.0
            }
          ]
        },
        "metadata": {
          "type": "object",
          "description": "Execution context and environment information",
          "properties": {
            "workspace_mode": {
              "type": "string",
              "description": "Isolation strategy used",
              "enum": ["worktree", "temp", "none"],
              "examples": ["worktree", "temp", "none"]
            },
            "lean_version": {
              "type": ["string", "null"],
              "description": "Lean toolchain version (if detected)",
              "examples": ["4.3.0", "4.2.0", null]
            },
            "lake_version": {
              "type": ["string", "null"],
              "description": "Lake build system version (if detected)",
              "examples": ["4.3.0", "4.2.0", null]
            },
            "repo_commit": {
              "type": ["string", "null"],
              "description": "Git commit hash (if available)",
              "pattern": "^[a-f0-9]{6,40}$|^null$",
              "examples": ["a1b2c3d4e5f6", "a1b2c3d4e5f6789012345678901234567890", null]
            }
          },
          "additionalProperties": false,
          "examples": [
            {
              "workspace_mode": "worktree",
              "lean_version": "4.3.0",
              "lake_version": "4.3.0",
              "repo_commit": "a1b2c3d4e5f6"
            },
            {}
          ]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "api_version": "1.1.0",
          "status": "success",
          "run_id": "probe-20250126-143022-a1b2c3d4-abc123",
          "probe_result": {
            "mode": "aesop",
            "outcome": "closed",
            "classification": "trivial",
            "suggested_script": null
          },
          "diagnostics": [],
          "timing": {
            "elapsed_ms": 245.5,
            "budget_s": 10.0
          },
          "metadata": {
            "workspace_mode": "worktree",
            "lean_version": "4.3.0",
            "lake_version": "4.3.0",
            "repo_commit": "a1b2c3d4e5f6"
          }
        },
        {
          "api_version": "1.1.0",
          "status": "fail",
          "run_id": "probe-20250126-143100-b2c3d4e5-def456",
          "probe_result": {
            "mode": "aesop",
            "outcome": "not_closed",
            "classification": "promising",
            "suggested_script": null
          },
          "diagnostics": [
            {
              "severity": "error",
              "message": "unsolved goals\n⊢ List α → List α → List α",
              "location": {
                "file": "MyProject/Theorems.lean",
                "line": 15,
                "col": 8,
                "end_line": 15,
                "end_col": 11
              }
            }
          ],
          "timing": {
            "elapsed_ms": 1820.3,
            "budget_s": 10.0
          },
          "metadata": {
            "workspace_mode": "worktree",
            "lean_version": "4.3.0",
            "lake_version": "4.3.0",
            "repo_commit": "a1b2c3d4e5f6"
          }
        },
        {
          "api_version": "1.1.0",
          "status": "success",
          "run_id": "probe-20250126-143200-c3d4e5f6-ghi789",
          "probe_result": {
            "mode": "aesop?",
            "outcome": "closed",
            "classification": "trivial",
            "suggested_script": "simp [List.append_assoc]"
          },
          "diagnostics": [],
          "timing": {
            "elapsed_ms": 312.8,
            "budget_s": 10.0
          },
          "metadata": {
            "workspace_mode": "worktree",
            "lean_version": "4.3.0",
            "lake_version": "4.3.0",
            "repo_commit": "a1b2c3d4e5f6"
          }
        },
        {
          "api_version": "1.1.0",
          "status": "timeout",
          "run_id": "probe-20250126-143300-d4e5f6g7-jkl012",
          "probe_result": {
            "mode": "grind",
            "outcome": "timeout",
            "classification": "timed_out",
            "suggested_script": null
          },
          "diagnostics": [],
          "timing": {
            "elapsed_ms": 5080.0,
            "budget_s": 5.0
          },
          "metadata": {
            "workspace_mode": "worktree",
            "lean_version": "4.3.0",
            "lake_version": "4.3.0",
            "repo_commit": "a1b2c3d4e5f6"
          }
        },
        {
          "api_version": "1.1.0",
          "status": "error",
          "run_id": "probe-20250126-143400-e5f6g7h8-mno345",
          "probe_result": {
            "mode": "aesop",
            "outcome": "error",
            "classification": "error",
            "suggested_script": null
          },
          "diagnostics": [
            {
              "severity": "error",
              "message": "Theorem not found: NonExistent.theorem",
              "location": null
            }
          ],
          "timing": {
            "elapsed_ms": 0.0,
            "budget_s": 10.0
          },
          "metadata": {}
        }
      ]
    }
  }
}
