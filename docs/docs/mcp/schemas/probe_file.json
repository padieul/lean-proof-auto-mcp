{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lean-proof-auto-mcp.org/schemas/probe_file.json",
  "title": "Probe File Tool Schema",
  "description": "Schema for the probe_file MCP tool that measures automation behavior across multiple theorems in a file",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": ["file", "mode"],
      "properties": {
        "api_version": {
          "type": "string",
          "description": "API version for schema compatibility tracking",
          "default": "1.1.0",
          "examples": ["1.1.0"]
        },
        "file": {
          "type": "string",
          "description": "Path to the .lean file to probe, relative to the project root",
          "minLength": 1,
          "examples": [
            "Mathlib/Data/List/Basic.lean",
            "MyProject/Theorems.lean"
          ]
        },
        "mode": {
          "type": "string",
          "description": "Automation mode to attempt on all theorems",
          "enum": ["aesop", "aesop?", "grind"],
          "examples": ["aesop", "aesop?", "grind"]
        },
        "budget_s_per": {
          "type": "number",
          "description": "Maximum wall-clock time (in seconds) allowed per theorem. Each theorem gets its own independent budget.",
          "default": 5.0,
          "minimum": 0.1,
          "maximum": 600.0,
          "examples": [5.0, 10.0, 3.0]
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of theorems to probe. Useful for sampling large files.",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "examples": [50, 10, 100]
        },
        "ordering": {
          "type": "string",
          "description": "Ordering mode for theorem enumeration. 'file_order' uses file position, 'rank_targets' uses rank_targets prioritization.",
          "default": "file_order",
          "enum": ["file_order", "rank_targets"],
          "examples": ["file_order", "rank_targets"]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "file": "Mathlib/Data/List/Basic.lean",
          "mode": "aesop",
          "budget_s_per": 5.0,
          "limit": 50,
          "ordering": "file_order"
        },
        {
          "file": "MyProject/Theorems.lean",
          "mode": "aesop?",
          "budget_s_per": 10.0,
          "limit": 10,
          "ordering": "rank_targets"
        }
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "api_version",
        "status",
        "file",
        "summary",
        "results",
        "metadata"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "description": "API version for schema compatibility tracking",
          "const": "1.1.0",
          "examples": ["1.1.0"]
        },
        "status": {
          "type": "string",
          "description": "Overall batch probe execution status. 'success' if all theorems probed successfully, 'partial' if some failed, 'error' if scan_file or enumeration failed.",
          "enum": ["success", "partial", "error"],
          "examples": ["success", "partial", "error"]
        },
        "file": {
          "type": "string",
          "description": "Echo of input file path",
          "minLength": 1,
          "examples": [
            "Mathlib/Data/List/Basic.lean",
            "MyProject/Theorems.lean"
          ]
        },
        "summary": {
          "type": "object",
          "description": "Aggregate statistics across all probed theorems",
          "required": ["total", "closed", "promising", "failed", "timed_out"],
          "properties": {
            "total": {
              "type": "integer",
              "description": "Total number of theorems probed",
              "minimum": 0,
              "examples": [50, 10, 100]
            },
            "closed": {
              "type": "integer",
              "description": "Number of theorems where automation closed the goal (classification: trivial)",
              "minimum": 0,
              "examples": [15, 3, 42]
            },
            "promising": {
              "type": "integer",
              "description": "Number of theorems where automation failed but produced shallow subgoals (classification: promising)",
              "minimum": 0,
              "examples": [20, 5, 30]
            },
            "failed": {
              "type": "integer",
              "description": "Number of theorems where automation failed decisively (classification: failed)",
              "minimum": 0,
              "examples": [10, 2, 25]
            },
            "timed_out": {
              "type": "integer",
              "description": "Number of theorems where automation exhausted the budget (classification: timed_out)",
              "minimum": 0,
              "examples": [5, 0, 3]
            }
          },
          "additionalProperties": false,
          "examples": [
            {
              "total": 50,
              "closed": 15,
              "promising": 20,
              "failed": 10,
              "timed_out": 5
            },
            {
              "total": 10,
              "closed": 3,
              "promising": 5,
              "failed": 2,
              "timed_out": 0
            }
          ]
        },
        "results": {
          "type": "array",
          "description": "Per-theorem probe results in deterministic order",
          "items": {
            "type": "object",
            "required": ["theorem_id", "outcome", "classification", "elapsed_ms"],
            "properties": {
              "theorem_id": {
                "type": "string",
                "description": "Identifier of the probed theorem",
                "minLength": 1,
                "examples": [
                  "List.append_assoc",
                  "MyProject.my_theorem"
                ]
              },
              "outcome": {
                "type": "string",
                "description": "Raw outcome of automation attempt",
                "enum": ["closed", "not_closed", "timeout", "error"],
                "examples": ["closed", "not_closed", "timeout", "error"]
              },
              "classification": {
                "type": "string",
                "description": "Deterministic classification of automation behavior",
                "enum": ["trivial", "promising", "failed", "timed_out", "error"],
                "examples": ["trivial", "promising", "failed", "timed_out", "error"]
              },
              "elapsed_ms": {
                "type": "number",
                "description": "Elapsed time for this theorem's probe in milliseconds",
                "minimum": 0,
                "examples": [245.5, 1820.3, 5080.0]
              },
              "suggested_script": {
                "type": ["string", "null"],
                "description": "Suggested proof script (only for aesop? mode when successful)",
                "default": null,
                "examples": [
                  null,
                  "simp [List.append_assoc]",
                  "aesop (add norm simp [List.cons_append])"
                ]
              }
            },
            "additionalProperties": false
          },
          "examples": [
            [
              {
                "theorem_id": "List.append_assoc",
                "outcome": "closed",
                "classification": "trivial",
                "elapsed_ms": 245.5,
                "suggested_script": null
              },
              {
                "theorem_id": "List.cons_append",
                "outcome": "not_closed",
                "classification": "promising",
                "elapsed_ms": 1820.3,
                "suggested_script": null
              },
              {
                "theorem_id": "List.reverse_reverse",
                "outcome": "timeout",
                "classification": "timed_out",
                "elapsed_ms": 5080.0,
                "suggested_script": null
              }
            ]
          ]
        },
        "metadata": {
          "type": "object",
          "description": "Execution context and environment information",
          "properties": {
            "workspace_mode": {
              "type": "string",
              "description": "Isolation strategy used",
              "enum": ["worktree", "temp", "none"],
              "examples": ["worktree", "temp", "none"]
            },
            "lean_version": {
              "type": ["string", "null"],
              "description": "Lean toolchain version (if detected)",
              "examples": ["4.3.0", "4.2.0", null]
            },
            "lake_version": {
              "type": ["string", "null"],
              "description": "Lake build system version (if detected)",
              "examples": ["4.3.0", "4.2.0", null]
            },
            "repo_commit": {
              "type": ["string", "null"],
              "description": "Git commit hash (if available)",
              "pattern": "^[a-f0-9]{6,40}$|^null$",
              "examples": ["a1b2c3d4e5f6", "a1b2c3d4e5f6789012345678901234567890", null]
            },
            "ordering_used": {
              "type": "string",
              "description": "Ordering mode that was used",
              "enum": ["file_order", "rank_targets"],
              "examples": ["file_order", "rank_targets"]
            },
            "limit_applied": {
              "type": "integer",
              "description": "Limit that was applied (may be less than requested if fewer theorems available)",
              "minimum": 0,
              "examples": [50, 10, 100]
            }
          },
          "additionalProperties": false,
          "examples": [
            {
              "workspace_mode": "worktree",
              "lean_version": "4.3.0",
              "lake_version": "4.3.0",
              "repo_commit": "a1b2c3d4e5f6",
              "ordering_used": "file_order",
              "limit_applied": 50
            },
            {}
          ]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "api_version": "1.1.0",
          "status": "success",
          "file": "Mathlib/Data/List/Basic.lean",
          "summary": {
            "total": 50,
            "closed": 15,
            "promising": 20,
            "failed": 10,
            "timed_out": 5
          },
          "results": [
            {
              "theorem_id": "List.append_assoc",
              "outcome": "closed",
              "classification": "trivial",
              "elapsed_ms": 245.5,
              "suggested_script": null
            },
            {
              "theorem_id": "List.cons_append",
              "outcome": "not_closed",
              "classification": "promising",
              "elapsed_ms": 1820.3,
              "suggested_script": null
            },
            {
              "theorem_id": "List.reverse_reverse",
              "outcome": "timeout",
              "classification": "timed_out",
              "elapsed_ms": 5080.0,
              "suggested_script": null
            }
          ],
          "metadata": {
            "workspace_mode": "worktree",
            "lean_version": "4.3.0",
            "lake_version": "4.3.0",
            "repo_commit": "a1b2c3d4e5f6",
            "ordering_used": "file_order",
            "limit_applied": 50
          }
        },
        {
          "api_version": "1.1.0",
          "status": "partial",
          "file": "MyProject/Theorems.lean",
          "summary": {
            "total": 8,
            "closed": 3,
            "promising": 5,
            "failed": 0,
            "timed_out": 0
          },
          "results": [
            {
              "theorem_id": "MyProject.theorem1",
              "outcome": "closed",
              "classification": "trivial",
              "elapsed_ms": 312.8,
              "suggested_script": "simp [List.append_assoc]"
            },
            {
              "theorem_id": "MyProject.theorem2",
              "outcome": "not_closed",
              "classification": "promising",
              "elapsed_ms": 2145.7,
              "suggested_script": null
            }
          ],
          "metadata": {
            "workspace_mode": "worktree",
            "lean_version": "4.3.0",
            "lake_version": "4.3.0",
            "repo_commit": "a1b2c3d4e5f6",
            "ordering_used": "rank_targets",
            "limit_applied": 10
          }
        },
        {
          "api_version": "1.1.0",
          "status": "error",
          "file": "NonExistent.lean",
          "summary": {
            "total": 0,
            "closed": 0,
            "promising": 0,
            "failed": 0,
            "timed_out": 0
          },
          "results": [],
          "metadata": {}
        }
      ]
    }
  }
}
