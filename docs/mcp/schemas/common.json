{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-proof-auto-mcp/schemas/common.json",
  "title": "Common schema components",
  "type": "object",
  "$defs": {
    "api_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Tool API major.minor version; bump major for breaking changes, minor for backward-compatible changes."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this tool invocation."
    },
    "status": {
      "type": "string",
      "enum": ["success", "fail", "error", "timeout"],
      "description": "Terminal status for the tool invocation."
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line", "col"],
          "properties": {
            "line": { "type": "integer", "minimum": 1 },
            "col": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
