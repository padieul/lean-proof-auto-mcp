{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lean-proof-auto-mcp.org/schemas/verify_output.json",
  "title": "Verify Tool Output Schema",
  "description": "Output schema for the verify MCP tool that provides deterministic, sandboxed, budget-bounded verification of Lean files and theorems",
  "type": "object",
  "required": [
    "api_version",
    "status",
    "run_id",
    "file",
    "theorem_id",
    "verification_scope_used",
    "diagnostics",
    "diagnostic_summary",
    "evidence",
    "metadata",
    "timing"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "description": "API version for schema compatibility tracking",
      "const": "0.2.0",
      "examples": ["0.2.0"]
    },
    "status": {
      "type": "string",
      "description": "Verification result status",
      "enum": ["success", "fail", "timeout", "error"],
      "examples": [
        "success",
        "fail",
        "timeout",
        "error"
      ]
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for artifact lookup and correlation. Format: verify-{timestamp}-{file_hash}-{random_suffix}",
      "pattern": "^verify-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}-[a-f0-9]{6}$",
      "examples": [
        "verify-20250126-143022-a1b2c3d4-abc123",
        "verify-20250126-143100-b2c3d4e5-def456"
      ]
    },
    "file": {
      "type": "string",
      "description": "Echo of input file path",
      "minLength": 1,
      "examples": [
        "Mathlib/Data/List/Basic.lean",
        "MyProject/Theorems.lean"
      ]
    },
    "theorem_id": {
      "type": ["string", "null"],
      "description": "Echo of input theorem_id (if provided)",
      "examples": [
        "List.append_assoc",
        "MyProject.my_theorem",
        null
      ]
    },
    "verification_scope_used": {
      "type": "string",
      "description": "Scope of verification performed",
      "enum": ["file", "theorem", "file_fallback", "none"],
      "examples": [
        "file",
        "theorem",
        "file_fallback",
        "none"
      ]
    },
    "diagnostics": {
      "type": "array",
      "description": "Structured compilation diagnostics from Lean, sorted deterministically by (file, line, col, severity, message)",
      "items": {
        "type": "object",
        "required": ["severity", "message", "location"],
        "properties": {
          "severity": {
            "type": "string",
            "description": "Error level",
            "enum": ["error", "warning", "info"],
            "examples": ["error", "warning", "info"]
          },
          "message": {
            "type": "string",
            "description": "Human-readable diagnostic message",
            "minLength": 1,
            "examples": [
              "type mismatch\n  Nat\nhas type\n  Type : Type 1\nbut is expected to have type\n  Prop : Type",
              "declaration uses 'sorry'"
            ]
          },
          "location": {
            "type": ["object", "null"],
            "description": "Source location of diagnostic",
            "required": ["file", "line", "col"],
            "properties": {
              "file": {
                "type": "string",
                "description": "File path",
                "minLength": 1,
                "examples": ["MyProject/BadTheorem.lean"]
              },
              "line": {
                "type": "integer",
                "description": "Line number (1-indexed)",
                "minimum": 1,
                "examples": [15, 42]
              },
              "col": {
                "type": "integer",
                "description": "Column number (1-indexed)",
                "minimum": 1,
                "examples": [8, 20]
              },
              "end_line": {
                "type": ["integer", "null"],
                "description": "End line number (optional)",
                "minimum": 1,
                "examples": [15, 45, null]
              },
              "end_col": {
                "type": ["integer", "null"],
                "description": "End column number (optional)",
                "minimum": 1,
                "examples": [11, 30, null]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "examples": [
        [],
        [
          {
            "severity": "error",
            "message": "type mismatch",
            "location": {
              "file": "MyProject/BadTheorem.lean",
              "line": 15,
              "col": 8,
              "end_line": 15,
              "end_col": 11
            }
          }
        ]
      ]
    },
    "diagnostic_summary": {
      "type": "object",
      "description": "Aggregate counts of diagnostics by severity. Counts always match diagnostics array.",
      "required": ["error_count", "warning_count", "info_count"],
      "properties": {
        "error_count": {
          "type": "integer",
          "description": "Number of error-level diagnostics",
          "minimum": 0,
          "examples": [0, 1, 5]
        },
        "warning_count": {
          "type": "integer",
          "description": "Number of warning-level diagnostics",
          "minimum": 0,
          "examples": [0, 2, 10]
        },
        "info_count": {
          "type": "integer",
          "description": "Number of info-level diagnostics",
          "minimum": 0,
          "examples": [0, 3, 8]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "error_count": 0,
          "warning_count": 0,
          "info_count": 0
        },
        {
          "error_count": 1,
          "warning_count": 0,
          "info_count": 0
        }
      ]
    },
    "evidence": {
      "type": "object",
      "description": "Supporting evidence for verification result",
      "required": ["stdout_excerpt", "stderr_excerpt", "notes"],
      "properties": {
        "stdout_excerpt": {
          "type": "string",
          "description": "Truncated stdout from Lean process (up to max_log_excerpt_chars)",
          "examples": [
            "Lean compilation successful\n",
            "",
            "Verification in progress...\n... (truncated)"
          ]
        },
        "stderr_excerpt": {
          "type": "string",
          "description": "Truncated stderr from Lean process (up to max_log_excerpt_chars)",
          "examples": [
            "",
            "error: type mismatch at line 15\n",
            "warning: declaration uses 'sorry'\n"
          ]
        },
        "notes": {
          "type": "array",
          "description": "Array of structured notes (error codes, context, metadata)",
          "items": {
            "type": "string",
            "maxLength": 200,
            "examples": [
              "error_code: type_mismatch",
              "timeout_exceeded",
              "budget_s: 5.0",
              "actual_s: 5.08",
              "scope: theorem",
              "abridged_file_created"
            ]
          },
          "maxItems": 10,
          "examples": [
            [],
            ["error_code: type_mismatch"],
            ["timeout_exceeded", "budget_s: 5.0", "actual_s: 5.08"],
            ["scope: theorem", "abridged_file_created"]
          ]
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Execution context and environment information",
      "properties": {
        "workspace_mode": {
          "type": "string",
          "description": "Isolation strategy used",
          "enum": ["worktree", "temp"],
          "examples": ["worktree", "temp"]
        },
        "workspace_id": {
          "type": "string",
          "description": "Unique workspace identifier",
          "examples": [
            "20250126-143022-abc123",
            "20250126-143100-def456"
          ]
        },
        "repo_commit": {
          "type": ["string", "null"],
          "description": "Git commit hash (if available)",
          "pattern": "^[a-f0-9]{6,40}$|^null$",
          "examples": [
            "a1b2c3d4e5f6",
            "a1b2c3d4e5f6789012345678901234567890",
            null
          ]
        },
        "lean_version": {
          "type": ["string", "null"],
          "description": "Lean toolchain version (if detected)",
          "examples": [
            "4.3.0",
            "4.2.0",
            null
          ]
        },
        "lake_version": {
          "type": ["string", "null"],
          "description": "Lake build system version (if detected)",
          "examples": [
            "4.3.0",
            "4.2.0",
            null
          ]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "workspace_mode": "worktree",
          "workspace_id": "20250126-143022-abc123",
          "repo_commit": "a1b2c3d4e5f6",
          "lean_version": "4.3.0",
          "lake_version": "4.3.0"
        },
        {}
      ]
    },
    "timing": {
      "type": "object",
      "description": "Execution time breakdown",
      "properties": {
        "total_s": {
          "type": "number",
          "description": "Total wall-clock time for verification (seconds)",
          "minimum": 0,
          "examples": [2.45, 1.82, 5.08]
        },
        "lean_execution_s": {
          "type": "number",
          "description": "Time spent in Lean process (seconds)",
          "minimum": 0,
          "examples": [2.12, 1.55, 5.08]
        },
        "overhead_s": {
          "type": "number",
          "description": "Tool overhead - workspace setup, cleanup, parsing (seconds). Typically < 0.5s",
          "minimum": 0,
          "examples": [0.33, 0.27, 0.0]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "total_s": 2.45,
          "lean_execution_s": 2.12,
          "overhead_s": 0.33
        },
        {}
      ]
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "api_version": "0.2.0",
      "status": "success",
      "run_id": "verify-20250126-143022-a1b2c3d4-abc123",
      "file": "Mathlib/Data/List/Basic.lean",
      "theorem_id": null,
      "verification_scope_used": "file",
      "diagnostics": [],
      "diagnostic_summary": {
        "error_count": 0,
        "warning_count": 0,
        "info_count": 0
      },
      "evidence": {
        "stdout_excerpt": "Lean compilation successful\n",
        "stderr_excerpt": "",
        "notes": []
      },
      "metadata": {
        "workspace_mode": "worktree",
        "workspace_id": "20250126-143022-abc123",
        "repo_commit": "a1b2c3d4e5f6",
        "lean_version": "4.3.0",
        "lake_version": "4.3.0"
      },
      "timing": {
        "total_s": 2.45,
        "lean_execution_s": 2.12,
        "overhead_s": 0.33
      }
    },
    {
      "api_version": "0.2.0",
      "status": "fail",
      "run_id": "verify-20250126-143100-b2c3d4e5-def456",
      "file": "MyProject/BadTheorem.lean",
      "theorem_id": null,
      "verification_scope_used": "file",
      "diagnostics": [
        {
          "severity": "error",
          "message": "type mismatch\n  Nat\nhas type\n  Type : Type 1\nbut is expected to have type\n  Prop : Type",
          "location": {
            "file": "MyProject/BadTheorem.lean",
            "line": 15,
            "col": 8,
            "end_line": 15,
            "end_col": 11
          }
        }
      ],
      "diagnostic_summary": {
        "error_count": 1,
        "warning_count": 0,
        "info_count": 0
      },
      "evidence": {
        "stdout_excerpt": "",
        "stderr_excerpt": "error: type mismatch at line 15\n",
        "notes": ["error_code: type_mismatch"]
      },
      "metadata": {
        "workspace_mode": "worktree",
        "workspace_id": "20250126-143100-def456",
        "repo_commit": "a1b2c3d4e5f6",
        "lean_version": "4.3.0",
        "lake_version": "4.3.0"
      },
      "timing": {
        "total_s": 1.82,
        "lean_execution_s": 1.55,
        "overhead_s": 0.27
      }
    },
    {
      "api_version": "0.2.0",
      "status": "timeout",
      "run_id": "verify-20250126-143300-d4e5f6g7-ghi789",
      "file": "MyProject/SlowProof.lean",
      "theorem_id": null,
      "verification_scope_used": "file",
      "diagnostics": [],
      "diagnostic_summary": {
        "error_count": 0,
        "warning_count": 0,
        "info_count": 0
      },
      "evidence": {
        "stdout_excerpt": "Verification in progress...\n... (truncated)",
        "stderr_excerpt": "",
        "notes": ["timeout_exceeded", "budget_s: 5.0", "actual_s: 5.08"]
      },
      "metadata": {
        "workspace_mode": "worktree",
        "workspace_id": "20250126-143300-jkl012",
        "repo_commit": "a1b2c3d4e5f6",
        "lean_version": "4.3.0",
        "lake_version": "4.3.0"
      },
      "timing": {
        "total_s": 5.08,
        "lean_execution_s": 5.08,
        "overhead_s": 0.0
      }
    },
    {
      "api_version": "0.2.0",
      "status": "error",
      "run_id": "verify-20250126-143400-e5f6g7h8-jkl012",
      "file": "NonExistent.lean",
      "theorem_id": null,
      "verification_scope_used": "none",
      "diagnostics": [
        {
          "severity": "error",
          "message": "File not found: NonExistent.lean",
          "location": null
        }
      ],
      "diagnostic_summary": {
        "error_count": 1,
        "warning_count": 0,
        "info_count": 0
      },
      "evidence": {
        "stdout_excerpt": "",
        "stderr_excerpt": "",
        "notes": ["error_code: input_validation_error"]
      },
      "metadata": {},
      "timing": {}
    }
  ]
}
